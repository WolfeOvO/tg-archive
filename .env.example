# Telegram API (from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890
TG_SESSION_STRING=

# Target channel (username or ID)
TG_CHANNEL=@your_channel

# Storage mounts are empty by default. To expose every OpenList driver in the
# WebUI, connect an OpenList v4 instance. No storage is created automatically.
OPENLIST_URL=
OPENLIST_USERNAME=
OPENLIST_PASSWORD=
OPENLIST_DEFAULT_MOUNT_ID=

# WebUI
ADMIN_PASSWORD=changeme
SECRET_KEY=change-this-to-a-random-secret-key
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/tg-archive.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/tg-archive.log

# Notifications (can also be configured in WebUI; WebUI settings persist in data/notifications.json)
NOTIFICATION_APP_NAME=TG Archive
NOTIFICATION_EVENTS=archive.failure,scan.summary,retry.summary
NOTIFICATION_TIMEOUT=10

# Telegram Bot notifications
NOTIFICATION_TELEGRAM_ENABLED=false
NOTIFICATION_TELEGRAM_BOT_TOKEN=
NOTIFICATION_TELEGRAM_CHAT_ID=

# Discord Incoming Webhook
NOTIFICATION_DISCORD_ENABLED=false
NOTIFICATION_DISCORD_WEBHOOK_URL=

# QQ via OneBot v11 HTTP (NapCat/Lagrange/etc.)
NOTIFICATION_QQ_ENABLED=false
NOTIFICATION_QQ_API_URL=http://127.0.0.1:3000
NOTIFICATION_QQ_ACCESS_TOKEN=
NOTIFICATION_QQ_TARGET_TYPE=group
NOTIFICATION_QQ_TARGET_ID=

# Generic JSON webhook (optional HMAC-SHA256 signature)
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
